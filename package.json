{
  "name": "roamsafe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "bash scripts/build.sh && bash scripts/check.sh",
    "test:chain": "tsc -p tsconfig.json --outDir target/ts && mocha -t 120000 target/ts/tests/**/*.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "client": "ts-node client/demo.ts",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "demo:setup": "ts-node client/setup-demo.ts",
    "test:render": "node scripts/smoke.mjs",
    "test:model": "tsc -p tsconfig.json --outDir target/ts && mocha target/ts/tests/model.js"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.0",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "buffer": "6.0.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "chai": "4.5.0",
    "mocha": "10.8.2",
    "ts-mocha": "10.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
